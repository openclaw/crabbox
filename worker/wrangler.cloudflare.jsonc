{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "crabbox-cloudflare-container-runner",
  "main": "src/cloudflare-container-runner.ts",
  "compatibility_date": "2026-09-29",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "containers": [
    {
      "class_name": "CrabboxSandbox",
      "scheduling_policy": "durable_object",
      "images": {
        "default": { "dockerfile": "./cloudflare-container.Dockerfile" },
      },
    },
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "CrabboxSandbox",
        "class_name": "CrabboxSandbox",
      },
    ],
  },
  "migrations": [
    {
      "tag": "cloudflare-container-v1",
      "new_sqlite_classes": ["Sandbox"],
    },
    {
      "tag": "cloudflare-container-v2",
      "new_sqlite_classes": [
        "SandboxLite",
        "SandboxBasic",
        "SandboxStandard1",
        "SandboxStandard2",
        "SandboxStandard3",
      ],
    },
    {
      "tag": "cloudflare-container-v3",
      "new_sqlite_classes": ["CrabboxSandbox"],
      "deleted_classes": [
        "Sandbox",
        "SandboxLite",
        "SandboxBasic",
        "SandboxStandard1",
        "SandboxStandard2",
        "SandboxStandard3",
      ],
    },
  ],
}
