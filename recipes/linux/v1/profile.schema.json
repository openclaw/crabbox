{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/openclaw/crabbox/blob/main/recipes/linux/v1/profile.schema.json",
  "title": "Crabbox Linux readiness profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "profile",
    "description",
    "satisfies",
    "aptPackages",
    "probes",
    "toolchains"
  ],
  "properties": {
    "schema": {
      "const": "crabbox-linux-readiness/v1"
    },
    "profile": {
      "enum": [
        "linux-minimal",
        "linux-builder"
      ]
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "satisfies": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "linux-minimal",
          "linux-builder"
        ]
      }
    },
    "aptPackages": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9+.-]*$"
      }
    },
    "probes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "command"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "command": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "toolchains": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "version",
          "source"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
