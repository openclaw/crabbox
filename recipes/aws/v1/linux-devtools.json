    "scripts/install-linux-developer-tools.sh",
    "scripts/smoke-aws-linux-devtools-image.sh",
    "scripts/scrub-aws-image.mjs",
    "scripts/scrub-aws-linux-image.sh"
  ],
  "components": [
    {
      "name": "crabbox-linux-builder",
      "version": "v1",
      "source": "recipes/linux/v1/linux-builder.json"
    },
    {
      "name": "node",
      "version": "24",
      "source": ".node-version"
    },
    {
      "name": "pnpm",
      "version": "11.1.0",
