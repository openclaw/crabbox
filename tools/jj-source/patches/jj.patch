+            }
+            let bytes = match Pin::new(&mut this.input).poll_fill_buf(cx) {
+                Poll::Pending => {
+                    return if written == 0 {
+                        Poll::Pending
+                    } else {
+                        Poll::Ready(Ok(written))
+                    };
+                }
+                Poll::Ready(Err(error)) => {
+                    if written == 0 {
+                        return Poll::Ready(Err(error));
+                    }
+                    // An error is not EOF: retain a held CR if the caller resumes.
+                    this.deferred_error = Some(error);
+                    return Poll::Ready(Ok(written));
+                }
+                Poll::Ready(Ok(bytes)) => bytes,
+            };
+            let Some(&byte) = bytes.first() else {
+                if this.pending_cr {
+                    output[written] = b'\r';
+                    written += 1;
+                    this.pending_cr = false;
+                }
+                return Poll::Ready(Ok(written));
+            };
+            if this.pending_cr {
+                this.pending_cr = false;
+                if byte != b'\n' {
+                    output[written] = b'\r';
+                    written += 1;
+                    continue;
+                }
+            }
+            match byte {
+                b'\r' => {
+                    Pin::new(&mut this.input).consume(1);
+                    this.pending_cr = true;
+                }
+                b'\n' => {
+                    Pin::new(&mut this.input).consume(1);
+                    if this.target_eol == TargetEol::Crlf {
+                        output[written] = b'\r';
+                        this.pending_lf = true;
+                    } else {
+                        output[written] = b'\n';
+                    }
+                    written += 1;
+                }
+                _ => {
+                    let available = bytes.len().min(output.len() - written);
+                    let count = bytes[..available]
+                        .iter()
+                        .position(|byte| matches!(byte, b'\r' | b'\n'))
+                        .unwrap_or(available);
+                    output[written..written + count].copy_from_slice(&bytes[..count]);
+                    written += count;
+                    Pin::new(&mut this.input).consume(count);
+                }
+            }
+        }
+        Poll::Ready(Ok(written))
+    }
 }
 
