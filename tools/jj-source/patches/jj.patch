+// distributed under the License is distributed on an "AS IS" BASIS,
+// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+// See the License for the specific language governing permissions and
+// limitations under the License.
+
+//! Cumulative byte accounting, including reservations for operations in progress.
+use std::sync::atomic::{AtomicU64, Ordering};
+
+#[derive(Debug)]
+pub(crate) struct ByteBudget {
+    limit: u64,
+    used: AtomicU64,
+}
+
+#[derive(Debug)]
+pub(crate) struct Exceeded {
+    pub used: u64,
+    pub requested: u64,
+    pub limit: u64,
+}
+
+impl ByteBudget {
+    pub fn new(limit: u64) -> Self {
+        Self {
+            limit,
+            used: AtomicU64::new(0),
+        }
+    }
+
+    pub fn used(&self) -> u64 {
+        self.used.load(Ordering::Acquire)
+    }
+
+    pub fn reserve(&self, bytes: u64) -> Result<Reservation<'_>, Exceeded> {
+        self.used
+            .fetch_update(Ordering::AcqRel, Ordering::Acquire, |used| {
+                used.checked_add(bytes).filter(|n| *n <= self.limit)
+            })
+            .map_err(|used| Exceeded {
+                used,
+                requested: bytes,
+                limit: self.limit,
+            })?;
+        Ok(Reservation {
+            budget: self,
+            bytes,
+        })
+    }
+}
+
+/// Uncommitted bytes are refunded on drop; committed bytes remain charged.
+pub(crate) struct Reservation<'a> {
+    budget: &'a ByteBudget,
+    bytes: u64,
+}
+
+impl Reservation<'_> {
+    pub fn bytes(&self) -> u64 {
+        self.bytes
+    }
+
+    pub fn commit(mut self, actual: u64) {
+        assert!(
+            actual <= self.bytes,
+            "cannot commit more bytes than reserved"
+        );
+        self.budget
+            .used
+            .fetch_sub(self.bytes - actual, Ordering::AcqRel);
+        self.bytes = 0;
+    }
+}
+
+impl Drop for Reservation<'_> {
+    fn drop(&mut self) {
+        self.budget.used.fetch_sub(self.bytes, Ordering::AcqRel);
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn partial_commit_and_abandoned_operation() {
+        let budget = ByteBudget::new(8);
+        let first = budget.reserve(5).unwrap();
+        let pending = budget.reserve(3).unwrap();
+        assert!(budget.reserve(1).is_err());
+        first.commit(2);
+        assert_eq!(budget.used(), 5);
+        drop(pending);
+        assert_eq!(budget.used(), 2);
+        budget.reserve(6).unwrap().commit(6);
+        assert_eq!(budget.used(), 8);
+    }
+
+    #[test]
+    fn zero_and_overflow() {
+        let zero = ByteBudget::new(0);
+        zero.reserve(0).unwrap().commit(0);
+        assert!(zero.reserve(1).is_err());
+        let budget = ByteBudget::new(u64::MAX);
+        budget.reserve(u64::MAX).unwrap().commit(u64::MAX);
+        assert!(budget.reserve(1).is_err());
+        assert_eq!(budget.used(), u64::MAX);
+    }
+}
