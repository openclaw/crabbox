+//! Session-owned payload output accounting. This does not bound materialization memory.
+
+use crate::byte_budget::{ByteBudget, Reservation};
+use std::io::{self, Write};
+use std::path::{Path, PathBuf};
+
+/// A payload write exceeded its per-entry or session ceiling.
+#[derive(Debug, thiserror::Error)]
+#[error(
+    "{purpose} budget exceeded ({scope}) at {path}: used {used}, requested {requested}, limit {limit}"
+)]
+pub struct CheckoutBudgetExceeded {
+    /// The independently accounted output stream.
+    pub purpose: &'static str,
+    /// Which ceiling rejected the write.
+    pub scope: &'static str,
+    /// Destination entry associated with the attempted write.
+    pub path: PathBuf,
+    /// Bytes already charged to the ceiling.
+    pub used: u64,
+    /// Bytes requested by this write.
+    pub requested: u64,
+    /// Configured maximum bytes.
+    pub limit: u64,
+}
+
+/// Shared accounting for materialized payload bytes, including symlink targets.
+#[derive(Debug)]
+pub struct CheckoutOutputBudget {
+    purpose: &'static str,
+    per_entry: u64,
+    total: ByteBudget,
+}
+
+impl CheckoutOutputBudget {
+    /// Constructs one budget for an entire owned checkout.
+    pub fn new(per_entry: u64, total: u64) -> Self {
+        Self {
+            purpose: "checkout output",
+            per_entry,
+            total: ByteBudget::new(total),
+        }
+    }
+
+    /// Bounds cumulative conflict scratch writes, separately from final payload.
+    pub fn for_conflict_scratch(limit: u64) -> Self {
+        Self {
+            purpose: "conflict scratch output",
+            per_entry: limit,
+            total: ByteBudget::new(limit),
+        }
+    }
+
+    /// Returns payload bytes charged so far, including writes in progress.
+    pub fn used(&self) -> u64 {
+        self.total.used()
+    }
+
+    fn reserve(&self, path: &Path, entry_used: u64, amount: u64) -> io::Result<Reservation<'_>> {
+        if entry_used
+            .checked_add(amount)
+            .is_none_or(|n| n > self.per_entry)
+        {
+            return Err(io::Error::other(CheckoutBudgetExceeded {
+                purpose: self.purpose,
+                scope: "entry",
+                path: path.to_owned(),
+                used: entry_used,
+                requested: amount,
+                limit: self.per_entry,
+            }));
+        }
+        self.total.reserve(amount).map_err(|err| {
+            io::Error::other(CheckoutBudgetExceeded {
+                purpose: self.purpose,
+                scope: "total",
+                path: path.to_owned(),
+                used: err.used,
+                requested: err.requested,
+                limit: err.limit,
+            })
+        })
+    }
+
+    /// Runs one all-or-error payload operation, such as creating a symlink.
+    pub fn write_entry<T>(
+        &self,
+        path: &Path,
+        bytes: u64,
+        write: impl FnOnce() -> io::Result<T>,
+    ) -> io::Result<T> {
+        let reservation = self.reserve(path, 0, bytes)?;
+        let value = write()?;
+        reservation.commit(bytes);
+        Ok(value)
+    }
+
+    /// Wraps a writer for one payload entry, sharing the checkout total.
+    pub fn writer<'a, W: Write>(&'a self, path: &'a Path, inner: W) -> BudgetedWriter<'a, W> {
+        BudgetedWriter {
+            budget: self,
+            path,
+            inner,
+            written: 0,
+        }
+    }
+}
+
+/// A destination writer whose successful bytes count toward both ceilings.
+pub struct BudgetedWriter<'a, W> {
+    budget: &'a CheckoutOutputBudget,
+    path: &'a Path,
+    inner: W,
+    written: u64,
+}
+
+impl<W: Write> Write for BudgetedWriter<'_, W> {
+    fn write(&mut self, data: &[u8]) -> io::Result<usize> {
+        let amount = u64::try_from(data.len()).map_err(io::Error::other)?;
+        let reservation = self.budget.reserve(self.path, self.written, amount)?;
+        match self.inner.write(data) {
+            Ok(n) if n <= data.len() => {
+                reservation.commit(n as u64);
+                self.written += n as u64;
+                Ok(n)
+            }
+            Ok(_) => {
+                reservation.commit(amount);
+                Err(io::Error::other("payload writer returned an invalid count"))
+            }
+            Err(err) => Err(err),
+        }
+    }
+    fn flush(&mut self) -> io::Result<()> {
+        self.inner.flush()
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use std::sync::Arc;
+
+    #[test]
+    fn entry_total_and_short_writes() {
+        let budget = CheckoutOutputBudget::new(5, 7);
+        let mut bytes = Vec::new();
+        let mut writer = budget.writer(Path::new("first"), &mut bytes);
+        writer.write_all(b"abc").unwrap();
+        let err = writer.write(b"def").unwrap_err();
+        assert_eq!(
+            err.get_ref()
+                .unwrap()
+                .downcast_ref::<CheckoutBudgetExceeded>()
+                .unwrap()
+                .scope,
+            "entry"
+        );
+        assert_eq!(budget.used(), 3);
+        let mut short = [0; 2];
+        assert_eq!(
+            budget
+                .writer(Path::new("second"), &mut short[..])
+                .write(b"1234")
+                .unwrap(),
+            2
+        );
+        assert_eq!(budget.used(), 5);
+        let err = budget
+            .writer(Path::new("third"), Vec::new())
+            .write(b"123")
+            .unwrap_err();
+        assert_eq!(
+            err.get_ref()
+                .unwrap()
+                .downcast_ref::<CheckoutBudgetExceeded>()
+                .unwrap()
+                .scope,
+            "total"
+        );
+        assert_eq!(budget.used(), 5);
+    }
+
+    #[test]
+    fn concurrent_entries_share_one_ceiling() {
+        let budget = Arc::new(CheckoutOutputBudget::new(4, 8));
+        let threads: Vec<_> = (0..8)
+            .map(|_| {
+                let budget = budget.clone();
+                std::thread::spawn(move || {
+                    budget
+                        .writer(Path::new("entry"), Vec::new())
+                        .write_all(b"1234")
+                        .is_ok()
+                })
+            })
+            .collect();
+        assert_eq!(
+            threads
+                .into_iter()
+                .map(|thread| thread.join().unwrap())
+                .filter(|ok| *ok)
+                .count(),
+            2
+        );
+        assert_eq!(budget.used(), 8);
+    }
+
+    #[test]
+    fn failed_entry_releases_its_reservation() {
+        let budget = CheckoutOutputBudget::new(4, 4);
+        assert!(
+            budget
+                .write_entry(Path::new("link"), 4, || Err::<(), _>(io::Error::other(
+                    "write failed"
+                )))
+                .is_err()
+        );
+        assert_eq!(budget.used(), 0);
+        budget.write_entry(Path::new("link"), 4, || Ok(())).unwrap();
+        assert_eq!(budget.used(), 4);
+    }
+}
