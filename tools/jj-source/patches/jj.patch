+//! Cumulative logical file and symlink input bytes, not decoder or live memory.
+use crate::byte_budget::{ByteBudget, Reservation};
+use crate::repo_path::RepoPath;
+
+/// A file or symlink read would exceed the session's logical input allowance.
+#[derive(Debug, thiserror::Error)]
+#[error(
+    "logical file input budget exceeded at {path}: used {used}, requested {requested}, limit {limit}"
+)]
+pub struct FileInputBudgetExceeded {
+    /// Native repository-relative path associated with the read.
+    pub path: String,
+    /// Committed bytes plus reservations already in progress.
+    pub used: u64,
+    /// Logical bytes requested by this read.
+    pub requested: u64,
+    /// Session limit.
+    pub limit: u64,
+}
+
+/// A shared cumulative allowance for successfully materialized file/symlink reads.
+#[derive(Debug)]
+pub struct FileInputBudget {
+    bytes: ByteBudget,
+}
+
+impl FileInputBudget {
+    /// Sets the total logical-byte allowance. Repeated reads are charged again.
+    pub fn new(limit: u64) -> Self {
+        Self {
+            bytes: ByteBudget::new(limit),
+        }
+    }
+
+    /// Returns successful bytes plus reservations for in-progress reads.
+    pub fn used(&self) -> u64 {
+        self.bytes.used()
+    }
+
+    pub(crate) fn reserve(
+        &self,
+        path: &RepoPath,
+        bytes: u64,
+    ) -> Result<Reservation<'_>, FileInputBudgetExceeded> {
+        self.bytes
+            .reserve(bytes)
+            .map_err(|err| FileInputBudgetExceeded {
+                path: path.as_internal_file_string().to_owned(),
+                used: err.used,
+                requested: err.requested,
+                limit: err.limit,
+            })
+    }
+}
