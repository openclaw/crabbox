+#[test]
+fn test_spooled_conflict_scratch_budget_and_cleanup() -> TestResult {
+    use jj_lib::checkout_budget::CheckoutOutputBudget;
+    use jj_lib::conflicts::{
+        MaterializedTreeValue, materialize_merge_result_to_bytes, materialize_tree_value,
+    };
+    use jj_lib::local_working_copy::LockedLocalWorkingCopy;
+    use std::any::Any;
+
+    let test_workspace = TestWorkspace::init();
+    let repo = &test_workspace.repo;
+    let first = repo_path("first");
+    let second = repo_path("second");
+    let left = create_tree(repo, &[(first, "left\n"), (second, "left\n")]);
+    let base = create_tree(repo, &[(first, "base\n"), (second, "base\n")]);
+    let right = create_tree(repo, &[(first, "right\n"), (second, "right\n")]);
+    let tree = MergedTree::merge(Merge::from_vec(vec![
+        (left, "left".into()),
+        (base, "base".into()),
+        (right, "right".into()),
+    ]))
+    .block_on()?;
+    let value = tree.path_value(first).block_on()?;
+    let MaterializedTreeValue::FileConflict(file) =
+        materialize_tree_value(repo.store(), first, value, tree.labels()).block_on()?
+    else {
+        panic!("fixture must have a native file conflict");
+    };
+    let options = ConflictMaterializeOptions {
+        marker_style: repo.settings().get("ui.conflict-marker-style")?,
+        marker_len: None,
+        merge: repo.store().merge_options().clone(),
+    };
+    let expected = materialize_merge_result_to_bytes(&file.contents, &file.labels, &options);
+    let size = expected.len() as u64;
+    let commit = commit_with_tree(repo.store(), tree);
+    for (paths, limit, succeeds) in [
+        (vec![first], size, true),
+        (vec![first], size - 1, false),
+        (vec![first, second], size * 2, true),
+        (vec![first, second], size * 2 - 1, false),
+    ] {
+        let owner = tempfile::tempdir()?;
+        let payload = owner.path().join("payload");
+        let state = owner.path().join("state");
+        std::fs::create_dir(&payload)?;
+        std::fs::create_dir(&state)?;
+        let owned = LocalWorkingCopy::init(
+            repo.store().clone(),
+            payload.clone(),
+            state.clone(),
+            repo.op_id().clone(),
+            test_workspace.workspace.workspace_name().to_owned(),
+            repo.settings(),
+        )?;
+        let mut locked = owned.start_mutation().block_on()?;
+        let budget = Arc::new(CheckoutOutputBudget::for_conflict_scratch(limit));
+        (&mut *locked as &mut dyn Any)
+            .downcast_mut::<LockedLocalWorkingCopy>()
+            .unwrap()
+            .set_conflict_scratch_budget(budget.clone())?;
+        locked
+            .set_sparse_patterns(paths.iter().map(|path| (*path).to_owned()).collect())
+            .block_on()?;
+        let result = locked.check_out(&commit).block_on();
+        if succeeds {
+            result?;
+            drop(locked.finish(repo.op_id().clone()).block_on()?);
+            assert_eq!(budget.used(), size * paths.len() as u64);
+            for path in paths {
+                assert_eq!(
+                    std::fs::read(path.to_fs_path_unchecked(&payload))?,
+                    expected.as_slice()
+                );
+            }
+        } else {
+            let error = result.unwrap_err();
+            assert!(format!("{error:?}").contains("conflict scratch output"));
+            drop(locked);
+            assert!(budget.used() <= limit);
+        }
+        assert!(std::fs::read_dir(&state)?.all(|entry| {
+            !entry
+                .unwrap()
+                .file_name()
+                .to_string_lossy()
+                .starts_with("jj-conflict-render-")
+        }));
+    }
     Ok(())
 }
 
